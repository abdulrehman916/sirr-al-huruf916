# Independent Sirr al-Huruf backend (browser-safe public values only)
VITE_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
VITE_SUPABASE_ANON_KEY=YOUR_PUBLIC_ANON_KEY
VITE_GOOGLE_AUTH_ENABLED=false

# Never place service-role, payment, email, or AI secrets in VITE_* variables.

# Server-only (Vercel → Settings → Environment Variables). Never prefix with VITE_.
# See docs/RAZORPAY_SETUP_ML.md. Test keys only until live payments are approved.
# RAZORPAY_KEY_ID=rzp_test_...
# RAZORPAY_KEY_SECRET=
# RAZORPAY_WEBHOOK_SECRET=
# SUPABASE_URL=https://YOUR_PROJECT.supabase.co
# SUPABASE_SERVICE_ROLE_KEY=
# RAZORPAY_ALLOW_LIVE=false
