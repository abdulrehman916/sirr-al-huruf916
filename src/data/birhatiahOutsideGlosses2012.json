{
  "source_id": "heshammamdouh-2012-birhatiah-glosses",
  "source_title": "معانى الاسماء ال 28 من البرهتيه باللغة العربيه",
  "source_author": "Hesham Mamdouh",
  "source_date": "2012-01-16",
  "source_url": "https://heshammamdouh.blogspot.com/2012/01/28.html",
  "source_kind": "online_blog_author_claim",
  "verification_status": "unverified_linguistic_meaning",
  "scope_note": {
    "ml": "2012-ലെ ബ്ലോഗ് രചയിതാവ് 28 നാമങ്ങൾക്ക് നൽകിയ വ്യത്യസ്ത അർത്ഥവ്യാഖ്യാനങ്ങളാണ്. സിറിയക്/അറബി ഭാഷാശാസ്ത്രപരമായി സ്വതന്ത്രമായി സ്ഥിരീകരിച്ച അർത്ഥങ്ങളല്ല. മൂലഗ്രന്ഥത്തിലെ അർത്ഥം, നാമത്തിന്റെ അക്ഷരങ്ങൾ, ഹറകത്ത്, അബ്ജദ്, ഓതൽസംഖ്യ, സമയം എന്നിവ മാറ്റുന്നില്ല. ഈ ലേഖനം അവയ്ക്കൊന്നും നിർദേശം നൽകുന്നില്ല.",
    "en": "Alternative glosses attributed to an author on a 2012 blog. These are NOT independently confirmed Syriac/Arabic etymologies or canonical meanings; they do not replace source-checked names, vowels, Abjad, recitation counts or timings. This article does not document those counts or timings."
  },
  "entries": [
    {
      "name_id": "HNK-MHC-001",
      "translation": {
        "ml": "അതിപരിശുദ്ധൻ",
        "en": "Most exalted in purity"
      }
    },
    {
      "name_id": "HNK-MHC-002",
      "translation": {
        "ml": "സകലത്തിന്റെയും ദൈവം",
        "en": "Deity of everything"
      }
    },
    {
      "name_id": "HNK-MHC-003",
      "translation": {
        "ml": "പരമപരിശുദ്ധൻ",
        "en": "The Most Holy"
      }
    },
    {
      "name_id": "HNK-MHC-004",
      "translation": {
        "ml": "എന്നും ജീവിക്കുന്നവൻ",
        "en": "The Ever-Living"
      }
    },
    {
      "name_id": "HNK-MHC-005",
      "translation": {
        "ml": "സ്വയം നിലനിൽക്കുന്ന പരിപാലകൻ",
        "en": "The Self-Subsisting Sustainer"
      }
    },
    {
      "name_id": "HNK-MHC-006",
      "translation": {
        "ml": "സ്നേഹനിധി",
        "en": "The Loving"
      }
    },
    {
      "name_id": "HNK-MHC-007",
      "translation": {
        "ml": "സമാധാനം നൽകുന്നവൻ",
        "en": "The Giver of Peace"
      }
    },
    {
      "name_id": "HNK-MHC-008",
      "translation": {
        "ml": "അല്ലാഹുവേ, അങ്ങയുടെ ദാസന്റെ അപേക്ഷ സ്വീകരിക്കേണമേ",
        "en": "O God, answer Your servant"
      }
    },
    {
      "name_id": "HNK-MHC-009",
      "translation": {
        "ml": "സർവാധിപതി",
        "en": "The Sovereign"
      }
    },
    {
      "name_id": "HNK-MHC-010",
      "translation": {
        "ml": "ശക്തനായവൻ",
        "en": "The Powerful"
      }
    },
    {
      "name_id": "HNK-MHC-011",
      "translation": {
        "ml": "എല്ലാം കേൾക്കുന്നവനും കാണുന്നവനും",
        "en": "The All-Hearing, All-Seeing"
      }
    },
    {
      "name_id": "HNK-MHC-012",
      "translation": {
        "ml": "എല്ലാറ്റിനെയും ഉൾക്കൊള്ളുന്നവൻ",
        "en": "The One encompassing everything"
      }
    },
    {
      "name_id": "HNK-MHC-013",
      "translation": {
        "ml": "അല്ലാഹു പരിശുദ്ധൻ",
        "en": "Glory be to God"
      }
    },
    {
      "name_id": "HNK-MHC-014",
      "translation": {
        "ml": "ഭയക്കുന്നവരുടെ അഭയമായ അല്ലാഹുവേ",
        "en": "O God, refuge of those who fear"
      }
    },
    {
      "name_id": "HNK-MHC-015",
      "translation": {
        "ml": "മതിയായവനും കേൾക്കുന്നവനും",
        "en": "The Sufficient and Hearing"
      }
    },
    {
      "name_id": "HNK-MHC-016",
      "translation": {
        "ml": "സുരക്ഷ നൽകുന്നവൻ",
        "en": "The Giver of security"
      }
    },
    {
      "name_id": "HNK-MHC-017",
      "translation": {
        "ml": "എല്ലാറ്റിന്റെയും മേൽനോട്ടം വഹിക്കുന്നവൻ",
        "en": "The Guardian"
      }
    },
    {
      "name_id": "HNK-MHC-018",
      "translation": {
        "ml": "മഹാനും ജ്ഞാനിയുമായവൻ",
        "en": "The Great and Wise"
      }
    },
    {
      "name_id": "HNK-MHC-019",
      "translation": {
        "ml": "പ്രതാപശാലി",
        "en": "The Mighty"
      }
    },
    {
      "name_id": "HNK-MHC-020",
      "translation": {
        "ml": "ഔദാര്യവാൻ",
        "en": "The Generous"
      }
    },
    {
      "name_id": "HNK-MHC-021",
      "translation": {
        "ml": "ശക്തനായവൻ അല്ലാഹുവാണ്",
        "en": "God is the Able"
      }
    },
    {
      "name_id": "HNK-MHC-022",
      "translation": {
        "ml": "അത്യുന്നതനും സർവജ്ഞനുമായവൻ",
        "en": "The Exalted, High and Knowing"
      }
    },
    {
      "name_id": "HNK-MHC-023",
      "translation": {
        "ml": "അവൻ എന്ന ദൈവസൂചന",
        "en": "He, as a divine reference"
      }
    },
    {
      "name_id": "HNK-MHC-024",
      "translation": {
        "ml": "സർവശക്തൻ",
        "en": "The All-Powerful"
      }
    },
    {
      "name_id": "HNK-MHC-025",
      "translation": {
        "ml": "ശാശ്വതനായവൻ",
        "en": "The Eternal"
      }
    },
    {
      "name_id": "HNK-MHC-026",
      "translation": {
        "ml": "എല്ലാറ്റിനും കഴിവുള്ളവൻ",
        "en": "The One able over all things"
      }
    },
    {
      "name_id": "HNK-MHC-027",
      "translation": {
        "ml": "നന്ദി അംഗീകരിക്കുന്നവൻ",
        "en": "The Appreciative"
      }
    },
    {
      "name_id": "HNK-MHC-028",
      "translation": {
        "ml": "കഴിവുള്ളവനും ഔദാര്യവാനും അല്ലാഹുവാണ്",
        "en": "God is Able and Generous"
      }
    }
  ]
}
